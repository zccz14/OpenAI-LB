# 监听与数据
LISTEN_ADDR=0.0.0.0:8080
DATABASE_URL=sqlite://openai-lb.sqlite?mode=rwc
RUST_LOG=openai_lb=info,tower_http=info

# 必填：`openssl rand -base64 32`。轮换前必须先重新加密现有渠道凭据。
ENCRYPTION_KEY=

# Auth Mini issuer 必须与启动 Auth Mini 时的 --issuer 完全相同。
AUTH_MINI_ISSUER=https://auth.example.com
# 可选；只有 Auth Mini 为 access token 签发 aud 时才设置。
AUTH_MINI_AUDIENCE=
# 可选；设置后仅该用户可成为管理员。未设置时，数据库首位用户原子地成为管理员。
ADMIN_USER_ID=

# CodeX / OpenAI 上游
CODEX_UPSTREAM_BASE=https://chatgpt.com/backend-api/codex
CODEX_OAUTH_AUTHORIZE_URL=https://auth.openai.com/oauth/authorize
CODEX_OAUTH_TOKEN_URL=https://auth.openai.com/oauth/token
CODEX_OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
CODEX_OAUTH_REDIRECT_URI=http://localhost:1455/auth/callback
IMAGE_HOST_MODEL=gpt-5.4

# Web 与代理边界
CORS_ALLOWED_ORIGINS=https://lb.example.com
MAX_BODY_BYTES=67108864
AFFINITY_TTL_SECONDS=86400
